@rendermode InteractiveServer
@using Shared.Contracts.Models
@inject WMSClient.Services.IWmsCameraService CameraService

<div class="card camera-card" @onclick="OnClick" style="cursor:pointer;">
    @if (string.IsNullOrEmpty(ThumbnailSrc))
    {
        <div class="camera-preview-placeholder">
            <div class="spinner-border text-secondary" role="status" style="width:2.5rem;height:2.5rem;" />
        </div>
    }
    else
    {
        <img src="@ThumbnailSrc" class="camera-preview" alt="@Camera.Nombre" loading="lazy" @onerror="OnImgError" />
    }
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="flex-grow-1 min-width-0">
                <div class="camera-name">@Camera.Nombre</div>
                <div class="camera-ip">@Camera.IpCamara</div>
            </div>
            <span class="badge flex-shrink-0 @(Camera.EstaConectada ? "bg-success" : "bg-danger")" style="font-size:0.7rem;">
                @(Camera.EstaConectada ? "●" : "○")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public AltaEventoModel Camera { get; set; } = new();

    [Parameter]
    public EventCallback<AltaEventoModel> OnSelected { get; set; }

    private string StreamPreviewUrl => CameraService.BuildStreamUrl(Camera.IpCamara);
    private string ThumbnailSrc { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        // Use lightweight thumbnail endpoint to avoid buffer or streaming calls on page load.
        try
        {
            // We only construct the URL; the browser will perform the GET when the <img> tag is rendered.
            ThumbnailSrc = CameraService.BuildThumbnailUrl(Camera.IpCamara);
        }
        catch { ThumbnailSrc = string.Empty; }
    }

    private async Task OnClick()
    {
        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync(Camera);
            StateHasChanged();
        }
    }

    private void OnImgError(EventArgs e)
    {
        // fallback to placeholder when image fails to load
        ThumbnailSrc = string.Empty;
    }
}
