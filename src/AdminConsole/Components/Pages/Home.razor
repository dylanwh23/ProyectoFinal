@page "/"
@rendermode InteractiveServer
<div class="vh-100">
    <div class="row h-50 bg-light">
        <div class="col"> 
            <NewEvent />
        </div>
        <div class="col">
            <Events Eventos="eventos" OnEventoSeleccionado="AlSeleccionarEvento" />
        </div>
    </div>
    <div class="row h-50 bg-dark text-white" style="max-height: 50%;">
        <div class="col border-end mh-100">        
            <Log Evento="eventoSeleccionado" />
        </div>
        <div class="col border-start mh-100">
            <Video Evento="eventoSeleccionado" />
        </div>
    </div>
</div>
