@using Admin.Console.Models.Components


<div class="h-75">
    <h3 class="text-center">Eventos registrados</h3>
<ul class="list-group h-75 overflow-auto">
  @foreach (EventModel evento in Eventos)
  {
    <li class="list-group-item" onclick="@(() => SeleccionarEvento(evento))" style="cursor:pointer;">@evento.IpCamera</li>
  }

</ul>
    <h4 class="text-center">Seleccione un evento para ver detalles</h4>
</div>