@using Admin.Console.Models.Components
@using Microsoft.AspNetCore.Components.Web

<div class="d-flex flex-column" style="height: 100%; min-height: 0; overflow: hidden;">
    <div class="row bg-light m-0" style="height: 50dvh; min-height: 0; overflow: hidden;">
        <div class="col-5 p-2 border-end d-flex flex-column" style="height: 100%; min-height: 0; overflow: auto;">
            <NewEvent />
        </div>
        <div class="col-7 p-2 d-flex flex-column" style="height: 100%; min-height: 0; overflow: hidden;">
            <Events OnEventoSeleccionado="AlSeleccionarEvento" />
        </div>
    </div>

    <div class="row bg-dark text-white m-0" style="height: 50dvh; min-height: 0; overflow: hidden;">
        <div class="col p-2 border-end h-100 d-flex flex-column" style="overflow: hidden;">
            <SavedEvents OnEventoSeleccionado="AlSeleccionarEvento" CameraIp="@SelectedCameraIp" CameraPuerto="@SelectedCameraPuerto" CameraTipo="@SelectedCameraTipo" />
        </div>
        <div class="col p-2 h-100" style="overflow: hidden;">
            <Video Evento="eventoSeleccionado" />
        </div>
    </div>
</div>
